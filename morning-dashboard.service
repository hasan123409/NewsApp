[Unit]
Description=Daily Morning Intelligence Dashboard HTTP Server (Port 8089)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/morning-dashboard
ExecStart=/opt/morning-dashboard/venv/bin/python3 /opt/morning-dashboard/serve.py -p 8089 -d /var/www/morning-dashboard
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
